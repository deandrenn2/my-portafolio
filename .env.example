# SQLite database file. In production (Dokploy) point this at the mounted
# volume so the data survives redeploys, e.g. file:./data/portafolio.db
DATABASE_URI=file:./portafolio.db

# Long random string used to sign Payload's tokens/sessions.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used by the Contacts collection to send emails via Gmail SMTP.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_PASS=your-gmail-app-password
